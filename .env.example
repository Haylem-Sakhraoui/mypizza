# PayPal Configuration
# Sandbox (development): Get from https://developer.paypal.com → My Apps → Sandbox app → Client ID
# Production (live):     Get from https://developer.paypal.com → My Apps → Live app → Client ID

VITE_PAYPAL_CLIENT_ID=your_live_client_id_here
VITE_PAYPAL_MODE=production

# Google Maps Embed API key
# Get from https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here
